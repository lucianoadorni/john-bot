# John Bot configuration — copy to .env and fill in.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Optional: your server's ID. When set, slash commands sync to that server
# instantly instead of taking up to an hour to appear globally.
GUILD_ID=

# Defaults every server starts with. /setup can override them per server.
WELCOME_CHANNEL_ID=
MEMBER_ROLE_ID=
STREAM_CHANNEL_ID=
WELCOME_MESSAGE=

# Seconds before the same member/stream link can be announced again.
STREAM_ALERT_COOLDOWN=3600

# Where guilds.json lives (relative to the repo unless absolute).
DATA_DIR=data

LOG_LEVEL=INFO
